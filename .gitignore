# ============================================================
# Lero Voice — repository ignore rules
# (merged: generic C rules + ESP-IDF firmware rules)
# ============================================================

# ---- Build artifacts and directories ----
**/build/
build/
*.o
*.a
*.out
*.elf
*.map
*.exe
*.obj
*.slo
*.lo
*.d
*.gch
*.pch
*.ilk
*.pdb
*.so
*.dylib
*.dll
*.so.*
*.mod
*.smod
*.lai
*.la
*.lib
*.dwo
*.app

# ---- CMake generated files ----
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
install_manifest.txt
compile_commands.json
Makefile

# ---- ESP-IDF specific ----
*.bin
flasher_args.json
sdkconfig.old
sdkconfig
!sdkconfig.defaults
!sdkconfig.ci
# ESP-IDF component manager (regenerable; includes docs reference SDKs too)
managed_components/
**/managed_components/
# ESP-IDF tools installed locally to the project
.espressif/

# ---- Temporary files ----
*~
*.swp
*.swo
*.bak
*.tmp
*.log
# local scratch (pip temp leftovers, pdf extraction, etc.)
.tmp/

# ---- Python ----
*.pyc
*.pyo
*.pyd
__pycache__/
*.egg-info/
dist/
venv/
.venv/
env/

# ---- Language servers / IDE ----
# 注意：.vscode/ 已提交共享配置（extensions/settings/c_cpp/tasks），勿整体忽略
.clangd/
.ccls-cache/
# User-specific configuration files
*.user
*.workspace
*.suo
*.sln.docstates

# ---- OS ----
.DS_Store
.AppleDouble
.LSOverride
.directory
Thumbs.db
ehthumbs.db
Desktop.ini

# ---- Misc ----
# test output & cache
Testing/
.cache/
# CI ccache (see .github/workflows/build.yml)
.ccache/
# vcpkg
vcpkg_installed/
