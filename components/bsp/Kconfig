menu "Lero Voice BSP"

config LERO_BSP_ENABLE_BUTTONS
    bool "Buttons (SW3~5)"
    default y

config LERO_BSP_ENABLE_POWER
    bool "Power monitor (BAT_ADC / BUS_ADC / LED)"
    default y

config LERO_BSP_ENABLE_USB
    bool "USB load switch (USB_EN)"
    default y

config LERO_BSP_ENABLE_AMPLIFIER
    bool "Amplifier (PA_CTRL)"
    default y

config LERO_BSP_ENABLE_SDCARD
    bool "MicroSD (SDIO 4-bit)"
    default y

config LERO_BSP_ENABLE_STORAGE
    bool "Storage partition (SPIFFS)"
    default y

config LERO_BSP_ENABLE_IMU
    bool "IMU (QMI8658A, polling)"
    default y

config LERO_BSP_ENABLE_CODEC
    bool "Audio codec (ES8389)"
    default y

config LERO_BSP_ENABLE_DISPLAY
    bool "RGB LCD + backlight"
    default y

config LERO_BSP_ENABLE_TOUCH
    bool "Capacitive touch (I2C1)"
    default y

config LERO_LCD_H_RES
    int "LCD horizontal resolution (px)"
    default 720

config LERO_LCD_V_RES
    int "LCD vertical resolution (px)"
    default 720

config LERO_LCD_RGB666_ALIGN
    bool "RGB565 → 18-bit RGB666 panel bit alignment (high-bits)"
    default y
    help
        ZJY400-8532ACT is an 18-bit RGB666 panel (DB0~5=B, DB6~11=G,
        DB12~17=R) but the S31 esp_lcd RGB driver only supports 16-bit
        data width, so RGB565 bits are routed with each channel's high
        bits aligned to the panel's high bits (DB0/DB12 left floating low).
        If the module OTP is actually programmed for a 16-bit RGB
        interface (IC-internal remap), disable this and use the direct
        DB0~15 mapping instead. Verify with solid-color test patterns.

config LERO_LCD_PIXEL_CLOCK_HZ
    int "LCD pixel clock (Hz)"
    default 46000000
    help
        NV3052C 720x720 (ZJY400-8532ACT)。厂商官方源码时序：H:
        HSW=60/HBP=120/HFP=106、V: VSW=4/VBP=20/VFP=20，PCLK 上升沿。
        上板实测：16MHz→20.8fps、**46MHz→59.8fps 显示正常（60fps 达成）**。
        注意：46MHz 超出规格书标称上限（≤35.7MHz），实测可用但量产需
        高低温/批量验证；异常时回退 16MHz（厂商默认值）。
        刷新率 = PCLK / (720+HSW+HBP+HFP) / (720+VSW+VBP+VFP)。

config LERO_LCD_HSYNC_PULSE
    int "LCD hsync pulse width (PCLK)"
    default 60

config LERO_LCD_HBP
    int "LCD hsync back porch (PCLK)"
    default 120

config LERO_LCD_HFP
    int "LCD hsync front porch (PCLK)"
    default 106

config LERO_LCD_VSYNC_PULSE
    int "LCD vsync pulse width (lines)"
    default 4

config LERO_LCD_VBP
    int "LCD vsync back porch (lines)"
    default 20

config LERO_LCD_VFP
    int "LCD vsync front porch (lines)"
    default 20

config LERO_LCD_BL_FREQ_HZ
    int "Backlight PWM frequency (Hz)"
    default 5000

config LERO_BAT_ADC_CHANNEL
    int "Battery ADC channel (ADC2: GPIO50=ch0 ... GPIO57=ch7)"
    default 0

config LERO_BUS_ADC_CHANNEL
    int "Bus voltage ADC channel (ADC2: GPIO50=ch0 ... GPIO57=ch7)"
    default 1

config LERO_BAT_DIVIDER_RATIO
    int "Battery divider ratio x100 (200 = 1/2)"
    default 200
    help
        Software divider assumption for BAT_ADC. NOTE: S31 ADC DB_0 full
        scale is 2000 mV (17-bit); with 1/2 divider a 4.2 V battery reads
        2.1 V (saturates at 2.0 V). Set per the actual schematic resistors
        and verify on hardware.

config LERO_BUS_DIVIDER_RATIO
    int "Bus divider ratio x100 (200 = 1/2)"
    default 200
    help
        Software divider assumption for BUS_ADC. With 1/2 divider a 5 V
        VBUS saturates the 2000 mV ADC scale (charging detection then uses
        the saturation heuristic). Set per the actual schematic resistors.

config LERO_BAT_LOW_MV
    int "Low battery threshold (mV)"
    default 3300

config LERO_BAT_CRITICAL_MV
    int "Critical battery threshold (mV)"
    default 3000

config LERO_BTN_DEBOUNCE_MS
    int "Button debounce (ms)"
    default 20

config LERO_BTN_LONG_MS
    int "Button long press threshold (ms)"
    default 3000

config LERO_BTN_VERY_LONG_MS
    int "Button very long press threshold (ms)"
    default 10000

config LERO_SD_BASE_PATH
    string "SD card mount point"
    default "/sdcard"

config LERO_SD_AUTOMOUNT
    bool "SD card hot-plug polling (auto mount/unmount)"
    default y
    help
        No SD_DET pin on this board (PLAN 2.6 #2): a static polling task
        probes the slot periodically — inserts auto-mount, removal
        (CMD13 status failure) auto-unmount.

config LERO_SD_POLL_PERIOD_MS
    int "SD hot-plug poll period (ms)"
    default 2000
    range 200 60000
    depends on LERO_SD_AUTOMOUNT

config LERO_SD_TASK_STACK_SIZE
    int "SD poll task stack (bytes)"
    default 4096
    depends on LERO_SD_AUTOMOUNT

config LERO_SD_TASK_PRIORITY
    int "SD poll task priority"
    default 5
    range 1 18
    depends on LERO_SD_AUTOMOUNT

config LERO_STORAGE_BASE_PATH
    string "Storage (SPIFFS) mount point"
    default "/storage"

endmenu

