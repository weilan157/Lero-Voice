menu "Lero Voice Voice Assistant"

config LERO_VOICE_TASK_PRIORITY
    int "voice_task priority"
    default 15
    range 1 18

config LERO_VOICE_TASK_STACK
    int "voice_task stack (bytes)"
    default 12288

config LERO_VOICE_TASK_CORE
    int "voice_task core (0=PRO_CPU, 1=APP_CPU)"
    default 1
    range 0 1

config LERO_VOICE_SAMPLE_RATE
    int "Capture sample rate (Hz; must match player/codec clock domain)"
    default 48000

config LERO_VOICE_CHANNELS
    int "Capture channels (2 = dual mic)"
    default 2
    range 1 2

config LERO_VOICE_FRAME_MS
    int "Capture frame length (ms)"
    default 20

config LERO_VOICE_LISTEN_TIMEOUT_MS
    int "Max listen duration (ms)"
    default 10000

config LERO_VOICE_VAD_RMS_THRESHOLD
    int "VAD RMS threshold (16-bit PCM; higher = less sensitive)"
    default 400

config LERO_VOICE_VAD_TAIL_MS
    int "VAD tail after last speech (ms)"
    default 800

config LERO_VOICE_MIN_UTTERANCE_MS
    int "Minimum utterance length before auto stop (ms)"
    default 400

config LERO_VOICE_RECORD_DEFAULT_SECONDS
    int "Default record duration (s, console 'rec')"
    default 30
    range 1 600

config LERO_VOICE_RECORD_MEM_BUF_KB
    int "In-RAM record buffer size (KB, static PSRAM; 'rec' without SD)"
    default 6144
    range 512 12288
    help
        Static buffer used when recording without an SD card (console "rec"
        with no path). 6 MB holds ~31 s at 48 kHz / 2 ch / 16 bit
        (192000 B/s). Placed in PSRAM via SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY.

config LERO_VOICE_RECORD_DEFAULT_PATH
    string "Default record output path (WAV on SD)"
    default "/sdcard/record/rec.wav"

endmenu
